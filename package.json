{
  "name": "@tetherto/wdk-protocol-bridge-usdt0-ton",
  "version": "1.0.0-beta.2",
  "description": "A simple package that lets @tetherto/wdk-wallet-ton and wallet-ton-gasless wallet accounts interact with the usdt0 protocol.",
  "keywords": [
    "wdk",
    "protocol",
    "bridge",
    "usdt0",
    "ton",
    "gasless"
  ],
  "author": "Tether",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git://github.com/tetherto/wdk-protocol-bridge-usdt0-ton.git"
  },
  "main": "index.js",
  "type": "module",
  "scripts": {
    "build:types": "tsc",
    "lint": "standard",
    "lint:fix": "standard --fix",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest",
    "test:coverage": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --coverage"
  },
  "dependencies": {
    "@tetherto/wdk-wallet": "^1.0.0-beta.1",
    "@tetherto/wdk-wallet-ton": "^1.0.0-beta.5",
    "@tetherto/wdk-wallet-ton-gasless": "^1.0.0-beta.3",
    "@ton/core": "0.59.1",
    "@ton/ton": "15.1.0",
    "@wdk-ton-packages/ui-bridge-oft": "1.0.0-canary.7",
    "@wdk-ton-packages/ui-core": "1.0.0-canary.3",
    "@wdk-ton-packages/ui-ton": "1.0.0-canary.6",
    "bare-wdk-runtime": "2.0.1"
  },
  "devDependencies": {
    "cross-env": "7.0.3",
    "jest": "29.7.0",
    "standard": "17.1.2",
    "typescript": "5.8.3"
  },
  "overrides": {
    "axios": "1.12.2",
    "@ton/core": "0.59.1",
    "mipd": "0.1.0-canary.20231012T134656",
    "0xsequence": {
      "ethers": "5.7.2"
    },
    "form-data": "4.0.4",
    "tsup": "8.5.0"
  },
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "bare": "./bare.js",
      "default": "./index.js"
    },
    "./package": {
      "default": "./package.json"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "standard": {
    "ignore": [
      "bare.js",
      "tests/**/*.js"
    ]
  }
}
